<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QuizSystem — Платформа тестування</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/quartz/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-lg navbar-dark glass-nav mb-4 sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
        <i class="bi bi-mortarboard-fill text-warning fs-4"></i>
        <span>Quiz<span class="text-warning">System</span></span>
      </a>
      
      <div class="d-flex align-items-center">
        <% if (currentUser) { %>
          <div class="user-pill me-3 d-flex align-items-center gap-2 px-3 py-1">
            <i class="bi <%= currentUser.role === 'teacher' ? 'bi-person-badge' : 'bi-mortarboard' %> text-warning"></i>
            <span class="fw-semibold text-white"><%= currentUser.fullName %></span>
            <span class="badge rounded-pill badge-role-orange ms-1">
              <%= currentUser.role === 'teacher' ? 'Викладач' : 'Студент' %>
            </span>
          </div>
          <a href="/logout" class="btn btn-sm btn-outline-light rounded-pill px-3">
            <i class="bi bi-box-arrow-right me-1"></i> Вийти
          </a>
        <% } %>
      </div>
    </div>
  </nav>
  <div class="container flex-grow-1">