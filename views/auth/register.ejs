<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>Реєстрація | QuizSystem</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.2/dist/quartz/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-screen">
  <div class="auth-card">
    <div class="text-center mb-2">
      <i class="bi bi-person-plus-fill fs-3 text-warning"></i>
      <h4 class="fw-bold text-white mb-0">Створення акаунта</h4>
      <p class="text-white-50 small mb-0" style="font-size: 0.78rem;">Приєднуйтесь до QuizSystem</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger py-1 px-2 small rounded-3 mb-2 text-center" style="font-size: 0.8rem;"><%= error %></div>
    <% } %>

    <form action="/register" method="POST">
      <div class="mb-2">
        <label class="form-label text-white-50">ПІБ (повне ім'я)</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-card-text"></i></span>
          <input type="text" name="fullName" class="form-control" required autocomplete="off">
        </div>
      </div>

      <div class="mb-2">
        <label class="form-label text-white-50">Логін</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-person"></i></span>
          <input type="text" name="username" class="form-control" required autocomplete="off">
        </div>
      </div>

      <div class="mb-2">
        <label class="form-label text-white-50">Пароль</label>
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-lock"></i></span>
          <input type="password" name="password" class="form-control" placeholder="••••••••" required>
        </div>
      </div>

      <div class="mb-2">
        <label class="form-label text-white-50">Роль у системі</label>
        <select name="role" class="form-select">
          <option value="student">Студент</option>
          <option value="teacher">Викладач</option>
        </select>
      </div>

      <button type="submit" class="btn btn-auth w-100 py-2 mt-2">
        Зареєструватися <i class="bi bi-check2-circle ms-1"></i>
      </button>
    </form>

    <div class="text-center mt-2 pt-2 border-top border-white-10">
      <span class="text-white-50 small" style="font-size: 0.8rem;">Вже зареєстровані?</span> 
      <a href="/login" class="text-warning text-decoration-none small fw-semibold ms-1" style="font-size: 0.8rem;">Увійти</a>
    </div>
  </div>
</body>
</html>