<%- include('../partials/header') %>

<div class="row justify-content-center mt-3 mb-5">
  <div class="col-md-9">
    <!-- Підсумковий бал -->
    <div class="card p-4 text-center mb-4">
      <div class="card-body">
        <h2 class="fw-bold mb-1">Результат тестування</h2>
        <h5 class="text-info mb-4"><%= testTitle %></h5>

        <% const percent = Math.round((score / maxScore) * 100); %>
        <div class="display-3 fw-bold mb-2 <%= percent >= 60 ? 'text-success' : 'text-danger' %>">
          <%= score %> / <%= maxScore %>
        </div>
        <p class="fs-4 text-muted mb-4">Успішність: <strong><%= percent %>%</strong></p>

        <% if (percent >= 60) { %>
          <div class="alert alert-success border-0 rounded-pill d-inline-block px-4 py-2">
            <i class="bi bi-check-circle-fill me-1"></i> Тест успішно складено!
          </div>
        <% } else { %>
          <div class="alert alert-danger border-0 rounded-pill d-inline-block px-4 py-2">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> Тест не складено. Спробуйте ще раз!
          </div>
        <% } %>

        <div class="mt-4">
          <a href="/student/dashboard" class="btn btn-outline-light rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> До списку тестів
          </a>
        </div>
      </div>
    </div>

    <!-- Детальний розбір помилок -->
    <h4 class="fw-bold mb-3"><i class="bi bi-list-check me-2"></i> Детальний розбір відповідей:</h4>

    <% reviewList.forEach((item, index) => { %>
      <div class="card mb-3 p-2 <%= item.isCorrect ? 'review-card-correct' : 'review-card-wrong' %>">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="fw-bold mb-0">
              <%= index + 1 %>. <%= item.questionText %>
            </h6>
            <span class="badge <%= item.isCorrect ? 'bg-success' : 'bg-danger' %> rounded-pill px-3 py-1">
              <%= item.points %> / <%= item.maxPoints %> бал.
            </span>
          </div>

          <div class="mt-3 small">
            <div class="mb-1">
              <span class="text-muted">Ваша відповідь:</span> 
              <strong class="<%= item.isCorrect ? 'text-success' : 'text-danger' %>">
                <%= item.userAnswer %>
                <% if (item.isCorrect) { %>
                  <i class="bi bi-check-lg ms-1"></i>
                <% } else { %>
                  <i class="bi bi-x-lg ms-1"></i>
                <% } %>
              </strong>
            </div>

            <% if (!item.isCorrect) { %>
              <div class="text-muted">
                Правильна відповідь: <strong class="text-success"><%= item.correctAnswers %></strong>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>

  </div>
</div>

<%- include('../partials/footer') %>