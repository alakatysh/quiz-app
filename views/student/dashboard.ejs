<%- include('../partials/header') %>

<div class="mb-4">
  <h2 class="fw-bold mb-1 text-white">Доступні тестування</h2>
  <p class="text-white-50 small">Оберіть тест зі списку нижче та перевірте свої знання</p>
</div>

<% if (tests.length === 0) { %>
  <div class="alert alert-info border-0 rounded-4 p-4 text-center">
    <i class="bi bi-journal-x fs-3 d-block mb-2"></i>
    Наразі немає відкритих тестів для проходження.
  </div>
<% } else { %>
  <div class="row mb-5">
    <% tests.forEach(test => { %>
      <div class="col-md-6 mb-4">
        <div class="card h-100 p-2">
          <div class="card-body">
            <h4 class="card-title fw-bold text-white mb-2"><%= test.title %></h4>
            <p class="card-text text-white-50 small mb-3"><%= test.description || 'Опис відсутній' %></p>
            
            <div class="d-flex gap-3 small text-white-50 mb-4">
              <span><i class="bi bi-clock me-1 text-warning"></i> Ліміт: <strong><%= test.timeLimit > 0 ? test.timeLimit + ' хв.' : 'Без обмежень' %></strong></span>
              <span><i class="bi bi-patch-question me-1 text-info"></i> Питань: <strong><%= test.questions.length %></strong></span>
            </div>
          </div>
          <div class="card-footer pt-0 border-0">
            <% if (test.questions.length > 0) { %>
              <a href="/student/test/<%= test._id %>" class="btn btn-start-test w-100">
                <i class="bi bi-play-circle me-1"></i> Розпочати тестування
              </a>
            <% } else { %>
              <button class="btn btn-disabled-glass w-100" disabled>
                <i class="bi bi-hourglass-split me-1"></i> Тест ще наповнюється
              </button>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="fw-bold mb-0 text-white">Мої попередні результати</h3>
</div>

<% if (results.length === 0) { %>
  <div class="card p-3 border-0 text-white-50 mb-5">
    <div><i class="bi bi-clock-history me-2"></i> Ви ще не завершили жодного тестування.</div>
  </div>
<% } else { %>
  <div class="student-table-wrap shadow mb-5">
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th>Назва тесту</th>
            <th>Дата складання</th>
            <th>Оцінка</th>
            <th>Успішність</th>
          </tr>
        </thead>
        <tbody>
          <% results.forEach(res => { %>
            <tr>
              <td><strong class="text-white"><%= res.test ? res.test.title : 'Видалений тест' %></strong></td>
              <td class="small text-white-50"><%= new Date(res.completedAt).toLocaleString('uk-UA') %></td>
              <td>
                <span class="badge badge-glass fs-6">
                  <%= res.score %> / <%= res.maxScore %>
                </span>
              </td>
              <td>
                <% const percent = Math.round((res.score / res.maxScore) * 100); %>
                <span class="badge badge-glass">
                  <%= percent %>%
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>