<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="fw-bold mb-1">Мої тести</h2>
    <p class="text-white-50 small mb-0">Створюйте та налаштовуйте тести для студентів</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/teacher/stats" class="btn btn-outline-light rounded-pill px-4">
      <i class="bi bi-journal-check me-1"></i> Журнал оцінок
    </a>
    <a href="/teacher/tests/create" class="btn btn-create-test">
      <i class="bi bi-plus-lg me-1"></i> Створити тест
    </a>
  </div>
</div>

<% if (tests.length === 0) { %>
  <div class="alert alert-info border-0 rounded-4 p-4 text-center">
    <i class="bi bi-folder-plus display-5 d-block mb-2"></i>
    <h5>У вас ще немає створених тестів</h5>
    <p class="small text-muted mb-3">Створіть свій перший тест та додайте до нього запитання</p>
    <a href="/teacher/tests/create" class="btn btn-create-test">Створити тест</a>
  </div>
<% } else { %>
  <div class="row">
    <% tests.forEach(test => { %>
      <div class="col-md-6 mb-4">
        <div class="card h-100 p-2">
          <div class="card-body">
            <h4 class="card-title fw-bold text-white mb-2"><%= test.title %></h4>
            <p class="card-text text-white-50 small mb-3"><%= test.description || 'Опис відсутній' %></p>
            
            <div class="d-flex gap-3 small text-white-50 mb-3">
              <span><i class="bi bi-clock me-1 text-warning"></i> <%= test.timeLimit > 0 ? test.timeLimit + ' хв.' : 'Без ліміту' %></span>
              <span><i class="bi bi-question-circle me-1 text-info"></i> <%= test.questions.length %> запитань</span>
            </div>
          </div>
          
          <div class="card-footer d-flex justify-content-between align-items-center pt-3 border-top">
            <a href="/teacher/tests/<%= test._id %>/questions" class="btn btn-sm btn-outline-light rounded-pill px-3">
              <i class="bi bi-pencil-square me-1"></i> Редагувати питання
            </a>
            <form action="/teacher/tests/<%= test._id %>/delete" method="POST" onsubmit="return confirm('Видалити цей тест?');">
              <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                <i class="bi bi-trash"></i> Видалити
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>